# Скопируй этот файл в .env и заполни значения
# .env НЕ коммитится в Git (он в .gitignore)

# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# Твой Telegram ID (для уведомлений админу)
ADMIN_ID=your_telegram_id_here

# Ссылка на закрытую группу
GROUP_LINK=https://t.me/+XXXXXXXXXX

# Claude API Key (получить на console.anthropic.com)
# Подключается на следующем этапе
ANTHROPIC_API_KEY=your_anthropic_key_here
